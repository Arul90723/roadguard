# RoadGuard Environment Variables Example
# Duplicate this file as .env for custom production/cloud configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# Google Cloud SQL (PostgreSQL with PostGIS)
# When omitted, the app automatically runs in zero-config In-Memory Demonstration Mode
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?sslmode=require
DATABASE_URL=postgresql://roadguard_user:your_secure_password_here@127.0.0.1:5432/roadguard

# Firebase Authentication (Optional in Local Demo Mode)
FIREBASE_PROJECT_ID=roadguard-kerala-safety
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@roadguard-kerala-safety.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Google Cloud Storage (Bucket for photographic evidence)
# When omitted, photos are safely written to server/uploads/ directory
GCS_BUCKET_NAME=roadguard-incident-photos

# Routing Service (Optional override)
# Default: OSRM public service with geometric corridor fallback
OSRM_ROUTER_URL=https://router.project-osrm.org
